{
    "swagger": "2.0",
    "info": {
        "description": "用户端 API 网关（BFF），将 HTTP 请求翻译为 ai-mate-core gRPC 调用。",
        "title": "AI Mate Client Gateway API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api",
    "paths": {
        "/auth/login": {
            "post": {
                "description": "使用账号密码 / 手机验证码 / 邮箱验证码 / OAuth 等方式登录，返回访问令牌与用户信息",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "用户登录",
                "parameters": [
                    {
                        "type": "string",
                        "description": "界面语言（zh-CN/zh-TW/en-US/ja-JP/ko-KR/ru-RU）",
                        "name": "X-Language",
                        "in": "header"
                    },
                    {
                        "description": "登录参数",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.Body"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/dto.LoginResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "请求参数错误",
                        "schema": {
                            "$ref": "#/definitions/response.Body"
                        }
                    },
                    "401": {
                        "description": "未授权",
                        "schema": {
                            "$ref": "#/definitions/response.Body"
                        }
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "注销当前访问令牌",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "用户登出",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bearer \u003ctoken\u003e",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.Body"
                        }
                    },
                    "401": {
                        "description": "未授权",
                        "schema": {
                            "$ref": "#/definitions/response.Body"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "返回服务名、环境、状态与启动时间",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "健康检查",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.Body"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/handler.HealthResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.LoginRequest": {
            "type": "object",
            "properties": {
                "account": {
                    "description": "账号，账号密码登录时使用。",
                    "type": "string"
                },
                "code": {
                    "description": "验证码，验证码登录时使用。",
                    "type": "string"
                },
                "codeVerifier": {
                    "description": "PKCE code_verifier。",
                    "type": "string"
                },
                "email": {
                    "description": "邮箱，邮箱验证码登录时使用。",
                    "type": "string"
                },
                "language": {
                    "description": "当前前端语言。",
                    "type": "string"
                },
                "method": {
                    "description": "登录方式，当前支持 account_password。",
                    "type": "string"
                },
                "oauthCode": {
                    "description": "OAuth 授权码。",
                    "type": "string"
                },
                "password": {
                    "description": "密码，账号密码登录时使用。",
                    "type": "string"
                },
                "phone": {
                    "description": "手机号，手机验证码登录时使用。",
                    "type": "string"
                },
                "redirectUri": {
                    "description": "OAuth 重定向 URI。",
                    "type": "string"
                }
            }
        },
        "dto.LoginResponse": {
            "type": "object",
            "properties": {
                "accessToken": {
                    "description": "访问令牌。",
                    "type": "string"
                },
                "expiresIn": {
                    "description": "过期时间，单位秒。",
                    "type": "integer"
                },
                "isNewUser": {
                    "description": "是否新用户。",
                    "type": "boolean"
                },
                "user": {
                    "description": "用户基础信息。",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.User"
                        }
                    ]
                }
            }
        },
        "dto.User": {
            "type": "object",
            "properties": {
                "avatar": {
                    "description": "头像 URL。",
                    "type": "string"
                },
                "id": {
                    "description": "用户 ID。",
                    "type": "string"
                },
                "language": {
                    "description": "用户首选语言。",
                    "type": "string"
                },
                "nickname": {
                    "description": "昵称。",
                    "type": "string"
                },
                "role": {
                    "description": "用户角色。",
                    "type": "string"
                },
                "username": {
                    "description": "用户名。",
                    "type": "string"
                }
            }
        },
        "handler.HealthResponse": {
            "type": "object",
            "properties": {
                "appName": {
                    "description": "服务名。",
                    "type": "string"
                },
                "env": {
                    "description": "运行环境。",
                    "type": "string"
                },
                "startedAt": {
                    "description": "服务启动时间。",
                    "type": "string"
                },
                "status": {
                    "description": "服务状态。",
                    "type": "string"
                }
            }
        },
        "response.Body": {
            "type": "object",
            "properties": {
                "code": {
                    "description": "业务码，0 表示成功。",
                    "type": "integer"
                },
                "data": {
                    "description": "响应数据。"
                },
                "message": {
                    "description": "响应消息。",
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Bearer 访问令牌，格式 \"Bearer \u003ctoken\u003e\"",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}